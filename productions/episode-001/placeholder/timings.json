  "sections": [
    {
      "id": "hook",
      "start": 0.0,
      "end": 18.723,
      "text": "Toʻxtang. Sizga yettita tanlov bor. Oxirigacha yetib bora olasizmi? Har safar ikkita yoʻl. Siz bittasini tanlaysiz. Notoʻgʻri javob yoʻq. Bu imtihon emas. Bu dasturxon atrofidagi oʻyin. Tayyormisiz? Unda boshlaymiz. Ekranga qarang. Ikkalasini ham koʻrib chiqing. Tanlov sizda. Bugun yettita eshik. Bittasini ham oʻtkazib yubormang."
    },
    {
      "id": "rules",
      "start": 18.723,
      "end": 37.872,
      "text": "Qoida oddiy. Men ikkita variantni aytaman. Ekranda ikkita rasm turadi. Sanoq chiqadi. Beshdan birgacha. Shu paytda siz tanlaysiz. Shoshilmang. Keyin bitta qisqa fakt eshitasiz. Soʻng keyingi tanlov. Yettita raund bor. Qiyinlik sekin oshadi. Birinchi raund yengil. Yettinchi raund eng qiziq. Tayyor boʻlsangiz, birinchi eshikni ochamiz."
    },
    {
      "id": "r1-choice",
      "start": 37.872,
      "end": 60.851,
      "text": "Birinchi tanlov. Palovmi yoki somsa? Koʻzingizni yumib koʻring. Issiq qozon. Guruch, sabzi va goʻsht birga pishadi. Uyga palov hidi kiradi. Yoki tandir. Yangi somsa. Xamir issiq. Ichlik ham issiq. Mehmonga qaysi birini qoʻyasiz? Katta laganmi? Yoki qoʻldagi somsa? Agar oila katta boʻlsa, lagan ochiladi. Agar vaqt qisqa boʻlsa, somsa qoʻlga tushadi. Qaysi birini tanlaysiz?"
    },
    {
      "id": "r1-count",
      "start": 60.851,
      "end": 70.128,
      "text": "Qarang. Besh. Toʻrt. Uch. Ikki. Bir. Tanlovingiz qabul qilindi."
    },
    {
      "id": "r1-fact",
      "start": 70.128,
      "end": 81.192,
      "text": "Fakt. Oʻzbekistonda shunday gap bor. Mehmonga palov tortilmaguncha, u uydan ketmaydi. Bu odat ikki ming oʻn olti yili YuNESKO roʻyxatiga kiritilgan. Birinchi tanlov boʻldi. Ikkinchisiga oʻting."
    },
    {
      "id": "r2-choice",
      "start": 81.192,
      "end": 104.171,
      "text": "Ikkinchi tanlov. Choy piyolasimi yoki bir qultum qatiq? Ertalab choy sekin ichiladi. Piyola qoʻlda turadi. Suhbat choʻziladi. Tushdan keyin qatiq. U salqin. Bir yutumda ham yetadi. Dasturxon har ikkalasini ham koʻtaradi. Siz qaysi paytni tanlaysiz? Ertalabki sokinlikmi? Yoki tushlikdagi salqinlik? Mehmon eshikdan kirsa, choy birinchi chiqadi. Bolalar esa qatiqni tez soʻraydi. Qaysi idishni uzatasiz?"
    },
    {
      "id": "r2-count",
      "start": 104.171,
      "end": 113.448,
      "text": "Qarang. Besh. Toʻrt. Uch. Ikki. Bir. Tanlovingiz qabul qilindi."
    },
    {
      "id": "r2-fact",
      "start": 113.448,
      "end": 122.384,
      "text": "Fakt. Choy avval piyolaga quyiladi. Soʻng choynakka qaytariladi. Buni uch marta qilishadi. Uchinchisidan keyin choy tayyor. Ikkinchi tanlov boʻldi. Uchinchisiga oʻting."
    },
    {
      "id": "r3-choice",
      "start": 122.384,
      "end": 141.107,
      "text": "Uchinchi tanlov. Samarqandmi yoki Buxoro? Samarqandda qadam keng. Maydon ochiq. Registon koʻz oldingizda. Osmon katta. Buxoroda qadam sekin. Koʻchalar tor. Soya yaqin. Devor yaqin. Siz qayerda yurasiz? Keng maydonmi? Yoki tor koʻchami? Bir kunlik sayrda bitta shahar. Ikkinchisini keyinga qoldirasiz. Qaysi eshikni bugun ochasiz?"
    },
    {
      "id": "r3-count",
      "start": 141.107,
      "end": 150.384,
      "text": "Qarang. Besh. Toʻrt. Uch. Ikki. Bir. Tanlovingiz qabul qilindi."
    },
    {
      "id": "r3-fact",
      "start": 150.384,
      "end": 163.575,
      "text": "Fakt. Registonda uchta madrasa bor. Ulugʻbek, Sherdor va Tillakori. Buxoroda Kalon minorasi bor. U ming bir yuz yigirma yetti yilda bitgan. Balandligi qariyb qirq olti metr. Uchinchi tanlov boʻldi. Toʻrtinchisiga oʻting."
    },
    {
      "id": "r4-choice",
      "start": 163.575,
      "end": 182.724,
      "text": "Toʻrtinchi tanlov. Doirami yoki rubob? Doira qoʻlda uriladi. Bayramda qoʻl yuradi. Tovush yaqin. Zal birga kiradi. Rubob torli cholgʻu. U sekin kuyni olib boradi. Tovush ingichka. Suhbat tinchlanadi. Qaysi tovush sizga yaqin? Doirami? Yoki rubobmi? Toʻyda doira yaqin turadi. Kechqurun rubob sekinroq. Qaysi tovushni eshitasiz?"
    },
    {
      "id": "r4-count",
      "start": 182.724,
      "end": 192.001,
      "text": "Qarang. Besh. Toʻrt. Uch. Ikki. Bir. Tanlovingiz qabul qilindi."
    },
    {
      "id": "r4-fact",
      "start": 192.001,
      "end": 199.235,
      "text": "Fakt. Doira ramkali baraban. Ichida koʻpincha metall halqalar turadi. Halqalar chalinganda jaranglaydi. Toʻrtinchi tanlov boʻldi. Beshinchisiga oʻting."
    },
    {
      "id": "r5-choice",
      "start": 199.235,
      "end": 217.958,
      "text": "Beshinchi tanlov. Kurashmi yoki futbol? Kurashda belbogʻ ushlanadi. Gilam ustida kuch sinashadi. Ikkita kurashchi yaqin. Nafas eshitiladi. Futbolda koptok oyoqda yuradi. Maydon keng. Ovoz baland. Qaysi tomosha sizni ushlab turadi? Gilammi? Yoki darvoza? Bolalar maydon chetida turadi. Kattalar gilam yonida turadi. Siz qayerda turasiz?"
    },
    {
      "id": "r5-count",
      "start": 217.958,
      "end": 227.235,
      "text": "Qarang. Besh. Toʻrt. Uch. Ikki. Bir. Tanlovingiz qabul qilindi."
    },
    {
      "id": "r5-fact",
      "start": 227.235,
      "end": 235.32,
      "text": "Fakt. Kurash belbogʻli kurash. Ikki ming oʻn sakkiz yili u Jakarta Osiyo oʻyinlarida boʻlgan. Beshinchi tanlov boʻldi. Oltinchisiga oʻting."
    },
    {
      "id": "r6-choice",
      "start": 235.32,
      "end": 254.894,
      "text": "Oltinchi tanlov biroz qiyinroq. Sumalakmi yoki holva? Bayram stoli yoningizda. Bitta shirinlik tanlaysiz. Sumalak Navroʻz dasturxonida turadi. U shirin. U quyuq. Qoshiq sekin yuradi. Holva ham shirin. Boʻlak kichik. Taʼmi boshqacha. Siz qaysini tanlaysiz? Qoshiqdami? Yoki boʻlakda? Onangiz qoshiq uzatadi. Qoʻshningiz boʻlak uzatadi. Qaysi birini olasiz?"
    },
    {
      "id": "r6-count",
      "start": 254.894,
      "end": 264.171,
      "text": "Qarang. Besh. Toʻrt. Uch. Ikki. Bir. Tanlovingiz qabul qilindi."
    },
    {
      "id": "r6-fact",
      "start": 264.171,
      "end": 273.958,
      "text": "Fakt. Navroʻz yigirma bir mart. Sumalak unib chiqqan bugʻdoydan tayyorlanadi. Sharbatini oʻn soatgacha qaynatishadi. Qozonni navbat bilan aralashtirishadi. Oltinchi tanlov boʻldi. Yettinchisiga oʻting."
    },
    {
      "id": "r7-choice",
      "start": 273.958,
      "end": 296.086,
      "text": "Yettinchi tanlov. Eng qiziq biri shu. Erta tongdagi bozormi yoki kechki hovlidagi dasturxon? Erta turasizmi? Yoki kech qolasizmi? Bozorda ovoz erta koʻtariladi. Savatlar toʻladi. Salomlar qisqa. Hovlida ovoz sekin tushadi. Chiroqlar yonadi. Qozon bugʻlanadi. Suhbat choʻziladi. Qaysi soat sizniki? Erta bozorda non issiq. Kechki hovlida choy ikkinchi marta. Siz qaysi soatni saqlaysiz?"
    },
    {
      "id": "r7-count",
      "start": 296.086,
      "end": 305.363,
      "text": "Qarang. Besh. Toʻrt. Uch. Ikki. Bir. Tanlovingiz qabul qilindi."
    },
    {
      "id": "r7-fact",
      "start": 305.363,
      "end": 315.576,
      "text": "Fakt. Non tandirga yopishishdan oldin chekich bilan bosiladi. Chekich markazda naqsh qoldiradi. Teshiklardan bugʻ chiqadi. Markaz tekis qoladi. Yettita tanlov tugadi. Siz oxirigacha yurdingiz."
    },
    {
      "id": "cta",
      "start": 315.576,
      "end": 333.448,
      "text": "Qaysi tanlov sizga qiyinroq boʻldi? Qaysi bittasi sizni oʻylatdi? Qaysi uchtasi oson tuyuldi? Izohda yozing. Bitta soʻz ham yetadi. Kanal nomi: Qani, tanlang! Obuna boʻling. Keyingi yettita tanlovni oʻtkazib yubormang. Doʻstingizga ham yuboring. Birga tanlang. Keyingi tanlovni ham kutib turing. Sizni kutamiz."
    },
    {
      "id": "ending",
      "start": 333.448,
      "end": 342.384,
      "text": "Oxirigacha yetib bordingiz. Yettita eshik ochildi. Siz tanladingiz. Rahmat. Keyingi safar yana birga tanlaysiz. Shu yerda xayrlashamiz. Tanlovingiz siz bilan qoladi."
    }
  ],
