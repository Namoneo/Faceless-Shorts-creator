    {
      "id": "r6-choice-6",
      "sectionId": "r6-choice",
      "start": 243.405,
      "end": 244.256,
      "text": "U quyuq."
    },
    {
      "id": "r6-choice-7",
      "sectionId": "r6-choice",
      "start": 244.256,
      "end": 245.533,
      "text": "Qoshiq sekin yuradi."
    },
    {
      "id": "r6-choice-8",
      "sectionId": "r6-choice",
      "start": 245.533,
      "end": 246.809,
      "text": "Holva ham shirin."
    },
    {
      "id": "r6-choice-9",
      "sectionId": "r6-choice",
      "start": 246.809,
      "end": 247.66,
      "text": "Boʻlak kichik."
    },
    {
      "id": "r6-choice-10",
      "sectionId": "r6-choice",
      "start": 247.66,
      "end": 248.511,
      "text": "Taʼmi boshqacha."
    },
    {
      "id": "r6-choice-11",
      "sectionId": "r6-choice",
      "start": 248.511,
      "end": 249.788,
      "text": "Siz qaysini tanlaysiz?"
    },
    {
      "id": "r6-choice-12",
      "sectionId": "r6-choice",
      "start": 249.788,
      "end": 250.213,
      "text": "Qoshiqdami?"
    },
    {
      "id": "r6-choice-13",
      "sectionId": "r6-choice",
      "start": 250.213,
      "end": 251.064,
      "text": "Yoki boʻlakda?"
    },
    {
      "id": "r6-choice-14",
      "sectionId": "r6-choice",
      "start": 251.064,
      "end": 252.341,
      "text": "Onangiz qoshiq uzatadi."
    },
    {
      "id": "r6-choice-15",
      "sectionId": "r6-choice",
      "start": 252.341,
      "end": 253.617,
      "text": "Qoʻshningiz boʻlak uzatadi."
    },
    {
      "id": "r6-choice-16",
      "sectionId": "r6-choice",
      "start": 253.617,
      "end": 254.894,
      "text": "Qaysi birini olasiz?"
    },
    {
      "id": "r6-count-0",
      "sectionId": "r6-count",
      "start": 254.894,
      "end": 255.703,
      "text": "Qarang."
    },
    {
      "id": "r6-count-1",
      "sectionId": "r6-count",
      "start": 255.703,
      "end": 256.511,
      "text": "Besh."
    },
    {
      "id": "r6-count-2",
      "sectionId": "r6-count",
      "start": 256.511,
      "end": 257.32,
      "text": "Toʻrt."
    },
    {
      "id": "r6-count-3",
      "sectionId": "r6-count",
      "start": 257.32,
      "end": 258.128,
      "text": "Uch."
    },
    {
      "id": "r6-count-4",
      "sectionId": "r6-count",
      "start": 258.128,
      "end": 258.937,
      "text": "Ikki."
    },
    {
      "id": "r6-count-5",
      "sectionId": "r6-count",
      "start": 258.937,
      "end": 259.745,
      "text": "Bir."
    },
    {
      "id": "r6-count-6",
      "sectionId": "r6-count",
      "start": 259.745,
      "end": 262.171,
      "text": "Tanlovingiz qabul qilindi."
    },
    {
      "id": "r6-fact-0",
      "sectionId": "r6-fact",
      "start": 264.171,
      "end": 264.597,
      "text": "Fakt."
    },
    {
      "id": "r6-fact-1",
      "sectionId": "r6-fact",
      "start": 264.597,
      "end": 266.299,
      "text": "Navroʻz yigirma bir mart."
    },
    {
      "id": "r6-fact-2",
      "sectionId": "r6-fact",
      "start": 266.299,
      "end": 268.426,
      "text": "Sumalak unib chiqqan bugʻdoydan tayyorlanadi."
    },
    {
      "id": "r6-fact-3",
      "sectionId": "r6-fact",
      "start": 268.426,
      "end": 270.128,
      "text": "Sharbatini oʻn soatgacha qaynatishadi."
    },
    {
      "id": "r6-fact-4",
      "sectionId": "r6-fact",
      "start": 270.128,
      "end": 271.83,
      "text": "Qozonni navbat bilan aralashtirishadi."
    },
    {
      "id": "r6-fact-5",
      "sectionId": "r6-fact",
      "start": 271.83,
      "end": 273.107,
      "text": "Oltinchi tanlov boʻldi."
    },
    {
      "id": "r6-fact-6",
      "sectionId": "r6-fact",
      "start": 273.107,
      "end": 273.958,
      "text": "Yettinchisiga oʻting."
    },
    {
      "id": "r7-choice-0",
      "sectionId": "r7-choice",
      "start": 273.958,
      "end": 274.809,
      "text": "Yettinchi tanlov."
    },
    {
      "id": "r7-choice-1",
      "sectionId": "r7-choice",
      "start": 274.809,
      "end": 276.511,
      "text": "Eng qiziq biri shu."
    },
    {
      "id": "r7-choice-2",
      "sectionId": "r7-choice",
      "start": 276.511,
      "end": 279.49,
      "text": "Erta tongdagi bozormi yoki kechki hovlidagi dasturxon?"
    },
    {
      "id": "r7-choice-3",
      "sectionId": "r7-choice",
      "start": 279.49,
      "end": 280.341,
      "text": "Erta turasizmi?"
    },
    {
      "id": "r7-choice-4",
      "sectionId": "r7-choice",
      "start": 280.341,
      "end": 281.618,
      "text": "Yoki kech qolasizmi?"
    },
    {
      "id": "r7-choice-5",
      "sectionId": "r7-choice",
      "start": 281.618,
      "end": 283.32,
      "text": "Bozorda ovoz erta koʻtariladi."
    },
    {
      "id": "r7-choice-6",
      "sectionId": "r7-choice",
      "start": 283.32,
      "end": 284.171,
      "text": "Savatlar toʻladi."
    },
    {
      "id": "r7-choice-7",
      "sectionId": "r7-choice",
      "start": 284.171,
      "end": 285.022,
      "text": "Salomlar qisqa."
    },
    {
      "id": "r7-choice-8",
      "sectionId": "r7-choice",
      "start": 285.022,
      "end": 286.724,
      "text": "Hovlida ovoz sekin tushadi."
    },
    {
      "id": "r7-choice-9",
      "sectionId": "r7-choice",
      "start": 286.724,
      "end": 287.575,
      "text": "Chiroqlar yonadi."
    },
    {
      "id": "r7-choice-10",
      "sectionId": "r7-choice",
      "start": 287.575,
      "end": 288.426,
      "text": "Qozon bugʻlanadi."
    },
    {
      "id": "r7-choice-11",
      "sectionId": "r7-choice",
      "start": 288.426,
      "end": 289.277,
      "text": "Suhbat choʻziladi."
    },
    {
      "id": "r7-choice-12",
      "sectionId": "r7-choice",
      "start": 289.277,
      "end": 290.554,
      "text": "Qaysi soat sizniki?"
    },
    {
      "id": "r7-choice-13",
      "sectionId": "r7-choice",
      "start": 290.554,
      "end": 292.256,
      "text": "Erta bozorda non issiq."
    },
    {
      "id": "r7-choice-14",
      "sectionId": "r7-choice",
      "start": 292.256,
      "end": 294.384,
      "text": "Kechki hovlida choy ikkinchi marta."
    },
    {
      "id": "r7-choice-15",
      "sectionId": "r7-choice",
      "start": 294.384,
      "end": 296.086,
      "text": "Siz qaysi soatni saqlaysiz?"
    },
    {
      "id": "r7-count-0",
      "sectionId": "r7-count",
      "start": 296.086,
      "end": 296.895,
      "text": "Qarang."
    },
    {
      "id": "r7-count-1",
      "sectionId": "r7-count",
      "start": 296.895,
      "end": 297.703,
      "text": "Besh."
    },
    {
      "id": "r7-count-2",
      "sectionId": "r7-count",
      "start": 297.703,
      "end": 298.512,
      "text": "Toʻrt."
    },
    {
      "id": "r7-count-3",
      "sectionId": "r7-count",
      "start": 298.512,
      "end": 299.32,
      "text": "Uch."
    },
    {
      "id": "r7-count-4",
      "sectionId": "r7-count",
      "start": 299.32,
      "end": 300.129,
      "text": "Ikki."
    },
    {
      "id": "r7-count-5",
      "sectionId": "r7-count",
      "start": 300.129,
      "end": 300.937,
      "text": "Bir."
    },
    {
      "id": "r7-count-6",
      "sectionId": "r7-count",
      "start": 300.937,
      "end": 303.363,
      "text": "Tanlovingiz qabul qilindi."
    },
    {
      "id": "r7-fact-0",
      "sectionId": "r7-fact",
      "start": 305.363,
      "end": 305.789,
      "text": "Fakt."
    },
    {
      "id": "r7-fact-1",
      "sectionId": "r7-fact",
      "start": 305.789,
      "end": 308.767,
      "text": "Non tandirga yopishishdan oldin chekich bilan bosiladi."
    },
    {
      "id": "r7-fact-2",
      "sectionId": "r7-fact",
      "start": 308.767,
      "end": 310.47,
      "text": "Chekich markazda naqsh qoldiradi."
    },
    {
      "id": "r7-fact-3",
      "sectionId": "r7-fact",
      "start": 310.47,
      "end": 311.746,
      "text": "Teshiklardan bugʻ chiqadi."
    },
    {
      "id": "r7-fact-4",
      "sectionId": "r7-fact",
      "start": 311.746,
      "end": 313.023,
      "text": "Markaz tekis qoladi."
    },
    {
      "id": "r7-fact-5",
      "sectionId": "r7-fact",
      "start": 313.023,
      "end": 314.299,
      "text": "Yettita tanlov tugadi."
    },
    {
      "id": "r7-fact-6",
      "sectionId": "r7-fact",
      "start": 314.299,
      "end": 315.576,
      "text": "Siz oxirigacha yurdingiz."
    },
    {
      "id": "cta-0",
      "sectionId": "cta",
      "start": 315.576,
      "end": 317.704,
      "text": "Qaysi tanlov sizga qiyinroq boʻldi?"
    },
    {
      "id": "cta-1",
      "sectionId": "cta",
      "start": 317.704,
      "end": 319.406,
      "text": "Qaysi bittasi sizni oʻylatdi?"
    },
    {
      "id": "cta-2",
      "sectionId": "cta",
      "start": 319.406,
      "end": 321.108,
      "text": "Qaysi uchtasi oson tuyuldi?"
    },
    {
      "id": "cta-3",
      "sectionId": "cta",
      "start": 321.108,
      "end": 321.959,
      "text": "Izohda yozing."
    },
    {
      "id": "cta-4",
      "sectionId": "cta",
      "start": 321.959,
      "end": 323.661,
      "text": "Bitta soʻz ham yetadi."
    },
    {
      "id": "cta-5",
      "sectionId": "cta",
      "start": 323.661,
      "end": 325.363,
      "text": "Kanal nomi: Qani, tanlang!"
    },
    {
      "id": "cta-6",
      "sectionId": "cta",
      "start": 325.363,
      "end": 326.214,
      "text": "Obuna boʻling."
    },
    {
      "id": "cta-7",
      "sectionId": "cta",
      "start": 326.214,
      "end": 328.342,
      "text": "Keyingi yettita tanlovni oʻtkazib yubormang."
    },
    {
      "id": "cta-8",
      "sectionId": "cta",
      "start": 328.342,
      "end": 329.618,
      "text": "Doʻstingizga ham yuboring."
    },
    {
      "id": "cta-9",
      "sectionId": "cta",
      "start": 329.618,
      "end": 330.469,
      "text": "Birga tanlang."
    },
    {
      "id": "cta-10",
      "sectionId": "cta",
      "start": 330.469,
      "end": 332.597,
      "text": "Keyingi tanlovni ham kutib turing."
    },
    {
      "id": "cta-11",
      "sectionId": "cta",
      "start": 332.597,
      "end": 333.448,
      "text": "Sizni kutamiz."
    },
    {
      "id": "ending-0",
      "sectionId": "ending",
      "start": 333.448,
      "end": 334.725,
      "text": "Oxirigacha yetib bordingiz."
    },
    {
      "id": "ending-1",
      "sectionId": "ending",
      "start": 334.725,
      "end": 336.001,
      "text": "Yettita eshik ochildi."
    },
    {
      "id": "ending-2",
      "sectionId": "ending",
      "start": 336.001,
      "end": 336.852,
      "text": "Siz tanladingiz."
    },
    {
      "id": "ending-3",
      "sectionId": "ending",
      "start": 336.852,
      "end": 337.278,
      "text": "Rahmat."
    },
    {
      "id": "ending-4",
      "sectionId": "ending",
      "start": 337.278,
      "end": 339.405,
      "text": "Keyingi safar yana birga tanlaysiz."
    },
    {
      "id": "ending-5",
      "sectionId": "ending",
      "start": 339.405,
      "end": 340.682,
      "text": "Shu yerda xayrlashamiz."
    },
    {
      "id": "ending-6",
      "sectionId": "ending",
      "start": 340.682,
      "end": 342.384,
      "text": "Tanlovingiz siz bilan qoladi."
    }
  ]
}
